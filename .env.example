# Copia este archivo como .env y rellena los valores reales.
# No subas .env al repositorio: contiene secretos.

ADMIN_TOKEN=REEMPLAZA_CON_UN_TOKEN_LARGO
SAVE_DIR=/home/TUUSUARIO/rocksoup-data
WORLD_ID=production

MYSQL_HOST=REEMPLAZA_HOST
MYSQL_PORT=3306
MYSQL_USER=REEMPLAZA_USUARIO
MYSQL_PASSWORD=REEMPLAZA_CLAVE
MYSQL_DATABASE=REEMPLAZA_BASE
MYSQL_SSL=true
MYSQL_CONNECTION_LIMIT=5
# Opcional: hosts alternativos separados por coma si el principal no responde.
# MYSQL_HOST_FALLBACKS=127.0.0.1,localhost

# Dominio público con HTTPS. Necesario para Google Sign-In y webhooks de PayPal.
PUBLIC_BASE_URL=https://tudominio.com

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web)
GOOGLE_CLIENT_ID=REEMPLAZA_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# PayPal Business -> Developer -> REST API app
# sandbox o live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=REEMPLAZA_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=REEMPLAZA_PAYPAL_CLIENT_SECRET
# Developer -> Webhooks -> ID del webhook apuntando a PUBLIC_BASE_URL/api/paypal/webhook
PAYPAL_WEBHOOK_ID=REEMPLAZA_PAYPAL_WEBHOOK_ID

PVP_INTERVAL_MS=300000
PVP_DURATION_MS=90000
