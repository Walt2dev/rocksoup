# Copia este archivo como .env y rellena los valores reales.
# No subas .env al repositorio: contiene secretos.

ADMIN_TOKEN=REEMPLAZA_CON_UN_TOKEN_LARGO
SAVE_DIR=/home/TUUSUARIO/rocksoup-data
WORLD_ID=production

MYSQL_HOST=REEMPLAZA_HOST
MYSQL_PORT=3306
MYSQL_USER=REEMPLAZA_USUARIO
MYSQL_PASSWORD=REEMPLAZA_CLAVE
MYSQL_DATABASE=REEMPLAZA_BASE
MYSQL_SSL=true
MYSQL_CONNECTION_LIMIT=5

PVP_INTERVAL_MS=300000
PVP_DURATION_MS=90000
