# Copia este archivo como .env y rellena los valores reales.
# No subas .env al repositorio: contiene secretos.

ADMIN_TOKEN=REEMPLAZA_CON_UN_TOKEN_LARGO
# Clave para entrar a /admin. Si se define, se acepta junto con ADMIN_TOKEN.
ADMIN_PASSWORD=REEMPLAZA_CON_TU_CLAVE_DE_ADMIN
# Clave alternativa de administración (tiene prioridad junto con las anteriores).
ADMIN_P2P=REEMPLAZA_CON_TU_CLAVE_P2P
SAVE_DIR=/home/TUUSUARIO/rocksoup-data
WORLD_ID=production

MYSQL_HOST=REEMPLAZA_HOST
MYSQL_PORT=3306
MYSQL_USER=REEMPLAZA_USUARIO
MYSQL_PASSWORD=REEMPLAZA_CLAVE
MYSQL_DATABASE=REEMPLAZA_BASE
MYSQL_SSL=true
MYSQL_CONNECTION_LIMIT=5
# Opcional: hosts alternativos separados por coma si el principal no responde.
# MYSQL_HOST_FALLBACKS=127.0.0.1,localhost

# Dominio público con HTTPS. Necesario para Google Sign-In.
PUBLIC_BASE_URL=https://tudominio.com

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web)
GOOGLE_CLIENT_ID=REEMPLAZA_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# La economía del juego no requiere variables adicionales: DracCoins, Prestigio
# y Esencias se gestionan con MySQL y el catálogo de js/game/economy.js.

# Correo de bienvenida y pruebas. Usa SMTP o el sendmail del hosting.
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@tudominio.com
# SMTP_PASSWORD=REEMPLAZA_CLAVE_DEL_BUZON
# MAIL_FROM=Sopa de Piedras <no-reply@tudominio.com>
# SENDMAIL_PATH=/usr/sbin/sendmail

PVP_INTERVAL_MS=300000
PVP_DURATION_MS=90000
